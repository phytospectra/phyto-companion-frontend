# ---------------------------------------------------------------------------
# Phytospectra frontend — environment template
#
# Copy to .env.local and fill in. Nothing prefixed NEXT_PUBLIC_ is secret:
# these values are inlined into the browser bundle. Server-only secrets must
# never appear here.
# ---------------------------------------------------------------------------

# Mock backend. true  -> every request is served by MSW in the browser, and
# auth short-circuits to a demo user. Used for local dev AND for demo
# deployments built with the flag baked in. false -> real API + Firebase.
NEXT_PUBLIC_USE_MOCKS=true

# Orchestrator base URL. Only used when NEXT_PUBLIC_USE_MOCKS=false.
# Local FastAPI default: http://localhost:8000
# Production: https://api.phytospectra.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Firebase web app (required when NEXT_PUBLIC_USE_MOCKS=false)
# Create a project and copy the web-app config from:
#   https://console.firebase.google.com/project/_/settings/general
# Auth must have the Google provider and Email/Password enabled.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Stripe — publishable key only. The secret key belongs on the backend, which
# creates Checkout Sessions; the browser never sees it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Playwright (optional). Overrides the base URL used by `npm run test:e2e`
# against an already-running server instead of starting one.
# ---------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL=http://localhost:3000

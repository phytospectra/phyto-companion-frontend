# Firebase — never commit real values, use this as a template.
# Generate yours at https://console.firebase.google.com/project/phyto-companion-prod/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API base URL — dev uses MSW mocks, prod uses the deployed orchestrator
# In this Next.js demo the same env var is read via process.env.NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Stripe (publishable key only — secret key stays on the backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
